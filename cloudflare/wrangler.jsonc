{
  "$schema": "https://json.schemastore.org/wrangler",
  "name": "tokengochi-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-08",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "env": {
    "staging": {
      "name": "tokengochi-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tokengochi-staging",
          "database_id": "00000000-0000-0000-0000-000000000000"
        }
      ],
      "vars": {
        "GROQ_WHISPER_MODEL": "whisper-large-v3",
        "GROQ_URL": "https://api.groq.com/openai/v1/audio/transcriptions",
        "TOKEN_SOURCE_MAX_AGE_SECONDS": "75"
      },
      "triggers": {
        "crons": ["*/1 * * * *"]
      }
    },
    "production": {
      "name": "tokengochi-production",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tokengochi-production",
          "database_id": "REPLACE_WITH_PRODUCTION_D1_DATABASE_ID"
        }
      ],
      "vars": {
        "GROQ_WHISPER_MODEL": "whisper-large-v3",
        "GROQ_URL": "https://api.groq.com/openai/v1/audio/transcriptions",
        "TOKEN_SOURCE_MAX_AGE_SECONDS": "75"
      },
      "triggers": {
        "crons": ["*/1 * * * *"]
      }
    }
  }
}
