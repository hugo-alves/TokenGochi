# Token Tamagotchi — bridge config
# Copy to `.env` and fill in. process.env always wins over this file.
# Delete any line you don't need; defaults in tamagotchi-bridge.mjs apply.

# Required for the HTTP bridge. Generate with: openssl rand -hex 32
# Must match DEVICE_TOKEN in firmware/src/secrets.h.
DEVICE_TOKEN=

# Bind to loopback by default. Set HOST=0.0.0.0 only when a device on your
# trusted LAN must reach this Mac directly.
# HOST=127.0.0.1

# Worker URL for the publish client (staging/production endpoint).
# Example: CLOUDFLARE_WORKER_URL=https://tokengochi-staging.yourname.workers.dev
# CLOUDFLARE_WORKER_URL=

# Secret for Cloudflare /ingest/tokens. Keep this in your local .env only.
# Must be different from DEVICE_TOKEN.
# INGEST_TOKEN=

# Optional interval between publish cycles (ms). Default 60000.
# INGEST_INTERVAL_MS=60000

# Token usage source. Local transcript logs are the safe default.
# TOKEN_USAGE_SOURCE=local

# EXPERIMENTAL: read an existing Codex access token and call an unsupported
# account-usage endpoint. This mode never refreshes or rewrites auth.json, but
# it may stop working without notice. Both values are required to opt in.
# TOKEN_USAGE_SOURCE=codex-account
# EXPERIMENTAL_CODEX_ACCOUNT_USAGE=1

# In account mode the API returns percent usage, not raw tokens. This scale
# preserves the existing food/token integer contract. Default: 1000.
# CODEX_USAGE_SCALE=1000

# Secret for the VPS token-source service. This is used when Cloudflare pulls
# from the VPS instead of receiving pushed snapshots. Keep it different from
# DEVICE_TOKEN and INGEST_TOKEN.
# TOKEN_SOURCE_TOKEN=

# Port for token-source.mjs on the VPS. Default 8790.
# TOKEN_SOURCE_PORT=8790

# The token source also binds to loopback by default. Keep it there when a
# local tunnel or Funnel proxies the service.
# TOKEN_SOURCE_HOST=127.0.0.1

# Port to bind the HTTP server on. Default 8787.
# PORT=8787

# Groq API key for Whisper transcription. Leave blank to disable /transcribe
# (the rest of the bridge still works; /transcribe returns 503).
# Get one at https://console.groq.com/keys
# GROQ_API_KEY=

# Whisper model. whisper-large-v3-turbo is ~3x cheaper and still great.
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Override the Groq endpoint. Useful for tests with a local mock server.
# Leave blank to use the real Groq API.
# GROQ_URL=https://api.groq.com/openai/v1/audio/transcriptions
