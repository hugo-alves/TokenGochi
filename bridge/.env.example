# Token Tamagotchi — bridge config
# Copy to `.env` and fill in. process.env always wins over this file.
# Delete any line you don't need; defaults in tamagotchi-bridge.mjs apply.

# Long random string. Must match DEVICE_TOKEN in firmware/src/secrets.h.
DEVICE_TOKEN=the-same-long-random-string-as-the-firmware

# Worker URL for the publish client (staging/production endpoint).
# Example: CLOUDFLARE_WORKER_URL=https://tokengochi-staging.yourname.workers.dev
# CLOUDFLARE_WORKER_URL=

# Secret for Cloudflare /ingest/tokens. Keep this in your local .env only.
# Must be different from DEVICE_TOKEN.
# INGEST_TOKEN=

# Optional interval between publish cycles (ms). Default 60000.
# INGEST_INTERVAL_MS=60000

# Port to bind the HTTP server on. Default 8787.
# PORT=8787

# Groq API key for Whisper transcription. Leave blank to disable /transcribe
# (the rest of the bridge still works; /transcribe returns 503).
# Get one at https://console.groq.com/keys
# GROQ_API_KEY=

# Whisper model. whisper-large-v3-turbo is ~3x cheaper and still great.
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Override the Groq endpoint. Useful for tests with a local mock server.
# Leave blank to use the real Groq API.
# GROQ_URL=https://api.groq.com/openai/v1/audio/transcriptions
