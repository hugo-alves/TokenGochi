#pragma once
// SECRET — gitignored. Copy secrets.h.example to secrets.h and fill in.
// These values must match the bridge's .env.

#ifndef SECRETS_H
#define SECRETS_H

// 2.4 GHz WiFi. The StopWatch does not support 5 GHz.
// Networks are tried in order. Put normal locations first and the phone
// hotspot last as a fallback.
#define WIFI_NETWORKS \
    { \
        { "home-ssid", "home-password" }, \
        { "office-ssid", "office-password" }, \
        { "phone-hotspot-ssid", "phone-hotspot-password" }, \
    }

// Must equal DEVICE_TOKEN in your token ingestion + bridge/worker config.
#define DEVICE_TOKEN  "replace-with-a-random-device-token"

#endif
